# Copy to `.env` next to docker-compose.yml and adjust. Every value has a demo default in the compose file.

# Public port of the website (http://localhost:8080)
WEB_PORT=8080

# --- Django ---
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True when served over HTTPS (production). False for a local run on plain http.
DJANGO_HTTPS=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
ADMIN_SITE_HEADER=Stavby Novák

# --- First admin account (created on first start only) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.sk

# 1 = fill the site with demo services/projects on start (idempotent). Use 0 for a real client.
SEED_DEMO=1

# --- Database ---
POSTGRES_DB=stavby
POSTGRES_USER=stavby
POSTGRES_PASSWORD=

# --- Email (console backend prints emails to `docker compose logs backend`) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.sk
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=web@example.sk
INQUIRY_NOTIFY_EMAIL=info@example.sk
