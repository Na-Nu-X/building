# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# DATABASE_URL=postgres://user:password@localhost:5432/stavby

# Public website URL (admin "Otvoriť web" link)
FRONTEND_URL=http://localhost:4200
ADMIN_SITE_HEADER=Stavby Novák

# --- Frontend origin(s) allowed to call /api ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Email (console backend prints to the terminal in development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.sk
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=web@example.sk
# Comma-separated list of recipients for new inquiry notifications
INQUIRY_NOTIFY_EMAIL=info@example.sk
INQUIRY_THROTTLE_RATE=10/hour
# Set to 1 when running behind nginx or another reverse proxy
NUM_PROXIES=0
